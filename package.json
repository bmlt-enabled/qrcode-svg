{
    "name": "@bmlt-enabled/qrcode-svg",
    "version": "1.2.0",
    "description": "A simple QR Code generator in pure JavaScript (browser and Node.js, ESM)",
    "author": "bmlt-enabled",
    "license": "MIT",
    "type": "module",
    "types": "./dist/qrcode.d.ts",
    "exports": {
        ".": {
            "types": "./dist/qrcode.d.ts",
            "import": "./dist/qrcode.js",
            "default": "./dist/qrcode.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && cp src/qrcode.d.ts dist/qrcode.d.ts",
        "serve": "vite --open /examples/",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "typecheck": "tsc -p test/types/tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "all": "npm run format && npm run lint && npm test && npm run build && npm run typecheck",
        "prepack": "npm run build",
        "prepublishOnly": "npm run lint && npm test"
    },
    "prettier": {
        "singleQuote": true,
        "semi": false,
        "tabWidth": 4
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "qrcode",
        "svg"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bmlt-enabled/qrcode-svg.git"
    },
    "bugs": {
        "url": "https://github.com/bmlt-enabled/qrcode-svg/issues"
    },
    "homepage": "https://github.com/bmlt-enabled/qrcode-svg",
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-html": "^8.2.1",
        "globals": "^17.6.0",
        "jsqr": "^1.4.0",
        "prettier": "^3.8.3",
        "sharp": "^0.35.5",
        "typescript": "^5.9.3",
        "vite": "^8.0.14",
        "vitest": "^5.0.0"
    }
}
